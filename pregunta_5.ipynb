      "source": [
        "def imprimeCombinaciones(n):\n",
        "  for i in range(n):\n",
        "    for j in range(n+1):\n",
        "      for k in range(n+2):\n",
        "        temp=j+i+k\n",
        "        if temp==5:\n",
        "          print({j},{i},{k})\n",
        "   \n",
        "      \n",
        "\n"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "num=int(input(\"ingrese un numero: \"))\n",
        "imprimeCombinaciones(num)"
      ],
