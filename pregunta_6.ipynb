      "source": [
        "def revierteCadena(cadena):\n",
        "  n=len(cadena)\n",
        "  if n<=1:\n",
        "    print(cadena)\n",
        "  else:\n",
        "    for i, c in enumerate(cadena):\n",
        "      j=n\n",
        "      for j in range(n):\n",
        "        j-=n-1\n",
        "        print(cadena[j])\n",
        "\n",
        "\n",
        "\n"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "oracion=input(\"Ingresa tu oracion: \")\n",
        "revierteCadena(oracion)"
      ],
