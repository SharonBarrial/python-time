      "source": [
        "def DobleProducto(n):\n",
        "  temp1=2**n\n",
        "  i=1\n",
        "  for i in range(n):\n",
        "    temp2=i*(i+1)\n",
        "  print(temp1*temp2)\n"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "numero=int(input(\"Ingrese un numero: \"))\n",
        "if numero >0:\n",
        "  DobleProducto(numero)"
      ],
